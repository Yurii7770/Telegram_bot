# OpenRouter API Key (Supports Claude 3.5 Sonnet, Gemini 2.5, DeepSeek R1, GPT-4o)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=@your_telegram_channel
ADMIN_CHAT_ID=123456789

# Publishing Mode: DIRECT (publish to channel directly) or ADMIN_PREVIEW (send to admin for approval)
PUBLISH_MODE=ADMIN_PREVIEW

# Polling Interval (in minutes)
CHECK_INTERVAL_MINUTES=15

# Target Twitter handles (comma separated)
TARGET_ACCOUNTS=DuneAnalytics,DefiLlama,MessariCrypto,vitalikbuterin

# Optional Twitter Auth Cookies (for Twikit)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Enable RSS Crypto News Feeds Fallback
ENABLE_RSS_FEEDS=true
